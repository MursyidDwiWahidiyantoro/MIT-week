# Copy to .env for `docker compose up`. Hosted deployments (Fly.io, Railway,
# Vercel) set the same names in their dashboards; see docs/DEPLOY.md.
#
# Comments sit on their own lines on purpose: Docker Compose reads
# `KEY=   # note` as the value "# note" when the value is empty.

# ---- Ports (Host bindings) ----
FRONTEND_PORT=80
BACKEND_PORT=8080

# ---- Backend Core ----
SERVER_HOST=0.0.0.0
# PaaS hosts inject PORT instead; SERVER_PORT wins when both are set.
SERVER_PORT=8080
# production requires REPORT_SIGNING_KEY, an https PUBLIC_APP_URL and LLM_MOCK=false.
ENVIRONMENT=development
# The web app's origin: CORS and the links in Telegram replies.
PUBLIC_APP_URL=http://localhost
# Optional, comma-separated exact origins (e.g. a custom domain next to *.vercel.app).
CORS_EXTRA_ORIGINS=
# "*" on Fly.io/Railway (only reachable through their proxy); empty locally.
TRUSTED_PROXY_CIDRS=
# Fly-Client-IP on Fly.io, X-Real-IP on Railway; empty = rightmost X-Forwarded-For.
CLIENT_IP_HEADER=
MAX_UPLOAD_SIZE_MB=10
HARD_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=600
# e.g. 127.0.0.1:9090 for Prometheus text metrics; empty = disabled.
METRICS_ADDR=

# ---- LLM Gateway / Mock ----
# Default: OpenRouter's free vision model (docs/DEPLOY.md §1.1). Any other
# OpenAI-compatible gateway works too (NineRouter, Gemini's own endpoint). The
# model must accept image input and json_schema structured output.
# The mock invents findings: never use it for real users.
LLM_MOCK=true
NINEROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter key (sk-or-...): only in .env or a host secret, never in git.
NINEROUTER_API_KEY=
# The boot log says llm_model_listed=true/false.
NINEROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Gateway-specific fields merged into every model request: OpenRouter falls
# back to other free models, and reasoning stays off to fit the time budget.
# Leave empty for NineRouter or Gemini.
LLM_EXTRA_BODY='{"models":["nvidia/nemotron-3.5-super-vl:free","openrouter/free"],"reasoning":{"enabled":false}}'
# NineRouter on the host machine instead:
# NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1

# ---- Security & External APIs ----
# >=32 random bytes, e.g. `openssl rand -base64 48` (required in production).
REPORT_SIGNING_KEY=
# One Google Cloud key with Fact Check Tools API and Safe Browsing API enabled.
GOOGLE_API_KEY=
# Optional per-service overrides of GOOGLE_API_KEY.
GOOGLE_FACTCHECK_KEY=
GOOGLE_SAFE_BROWSING_KEY=
# Optional dedicated AI-image detector for Jejak AI (sightengine.com, model
# "genai"). Set both or neither. Images are then also sent to Sightengine.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ---- Telegram bot (optional, PRD P2) ----
# From @BotFather; empty = bot disabled.
TELEGRAM_BOT_TOKEN=
# polling for local runs; webhook when hosted behind https.
TELEGRAM_MODE=polling
# Webhook mode: >=16 chars of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Webhook mode: https://<api-host>/telegram/webhook (registered at boot).
TELEGRAM_WEBHOOK_URL=

# ---- Frontend (Development override) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
# mock = no server needed; http = talk to the API above.
VITE_API_MODE=mock
