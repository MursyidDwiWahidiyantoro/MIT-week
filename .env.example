# ---- Ports (Host bindings) ----
FRONTEND_PORT=80
BACKEND_PORT=8080

# ---- Backend Core ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development            # production requires REPORT_SIGNING_KEY (>=32 bytes)
PUBLIC_APP_URL=http://localhost
TRUSTED_PROXY_CIDRS=               # leave empty until hosting is set up
MAX_UPLOAD_SIZE_MB=10
HARD_TIMEOUT_MS=20000             # Maru reasoning needs headroom for image audits
CACHE_TTL_SECONDS=600
METRICS_ADDR=                      # empty = disabled

# ---- LLM Gateway / Mock ----
LLM_MOCK=true
# When LLM_MOCK=false, use host.docker.internal to reach NineRouter on host machine.
# NINEROUTER_MODEL is the combo name, not the upstream provider model.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=changeme
NINEROUTER_MODEL=Maru
NINEROUTER_REASONING_EFFORT=low    # minimal|low|medium|high; low keeps audits inside the budget

# ---- Fact retrieval ----
# Retrieval is skipped in mock mode. It queries a fixed news endpoint and keeps
# only allowlisted publishers; the model never supplies a source URL.
FACT_RETRIEVAL=true
FACT_SEARCH_URL=https://www.bing.com/news/search

# ---- Security & External APIs (Optional) ----
REPORT_SIGNING_KEY=                # >=32 random bytes, base64 (required in production)
GOOGLE_SAFE_BROWSING_KEY=          # optional

# ---- Frontend (Development override) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_MODE=mock
