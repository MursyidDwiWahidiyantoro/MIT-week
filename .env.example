# Copy to .env for `docker compose up`. Hosted deployments (Fly.io, Railway,
# Vercel) set the same names in their dashboards; see docs/DEPLOY.md.

# ---- Ports (Host bindings) ----
FRONTEND_PORT=80
BACKEND_PORT=8080

# ---- Backend Core ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080                   # PaaS hosts inject PORT instead; SERVER_PORT wins when both are set
ENVIRONMENT=development            # production requires REPORT_SIGNING_KEY, an https PUBLIC_APP_URL and LLM_MOCK=false
PUBLIC_APP_URL=http://localhost    # the web app's origin: CORS and the links in Telegram replies
CORS_EXTRA_ORIGINS=                # optional, comma-separated exact origins (e.g. a custom domain next to *.vercel.app)
TRUSTED_PROXY_CIDRS=               # "*" on Fly.io/Railway (only reachable through their proxy); empty locally
CLIENT_IP_HEADER=                  # Fly-Client-IP on Fly.io, X-Real-IP on Railway; empty = rightmost X-Forwarded-For
MAX_UPLOAD_SIZE_MB=10
HARD_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=600
METRICS_ADDR=                      # e.g. 127.0.0.1:9090 for Prometheus text metrics; empty = disabled

# ---- LLM Gateway / Mock ----
# Any OpenAI-compatible gateway works (NineRouter, or Gemini's own endpoint
# https://generativelanguage.googleapis.com/v1beta/openai). The model must
# accept image input and json_schema structured output.
LLM_MOCK=true                      # the mock invents findings: never use it for real users
# When LLM_MOCK=false, use host.docker.internal to reach NineRouter on the host machine:
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=changeme
NINEROUTER_MODEL=gemini-3.8-flash  # verify against /models: the boot log says model_listed=true/false

# ---- Security & External APIs ----
REPORT_SIGNING_KEY=                # >=32 random bytes, e.g. `openssl rand -base64 48` (required in production)
GOOGLE_API_KEY=                    # one Google Cloud key with Fact Check Tools API and Safe Browsing API enabled
GOOGLE_FACTCHECK_KEY=              # optional: overrides GOOGLE_API_KEY for Fact Check Tools only
GOOGLE_SAFE_BROWSING_KEY=          # optional: overrides GOOGLE_API_KEY for Safe Browsing only

# ---- Telegram bot (optional, PRD P2) ----
TELEGRAM_BOT_TOKEN=                # from @BotFather; empty = bot disabled
TELEGRAM_MODE=polling              # polling for local runs; webhook when hosted behind https
TELEGRAM_WEBHOOK_SECRET=           # webhook mode: >=16 chars of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_URL=              # webhook mode: https://<api-host>/telegram/webhook (registered at boot)

# ---- Frontend (Development override) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_MODE=mock                 # mock = no server needed; http = talk to the API above
