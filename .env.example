# ---- backend ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development            # production requires REPORT_SIGNING_KEY
PUBLIC_APP_URL=http://localhost:5173
TRUSTED_PROXY_CIDRS=               # leave empty until hosting is set up
NINEROUTER_BASE_URL=http://localhost:20128/v1
